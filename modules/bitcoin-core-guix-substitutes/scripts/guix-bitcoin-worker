#!/usr/bin/env bash

set -euo pipefail

data_dir=${GUIX_BITCOIN_DATA_DIR:?GUIX_BITCOIN_DATA_DIR is required}
jobs_dir=$data_dir/jobs
profiles_root=$data_dir/profiles
repositories_dir=$data_dir/repositories
repo_dir=$repositories_dir/bitcoin.git
git_lock=$repositories_dir/git.lock
worktrees_root=$data_dir/worktrees
build_jobs=${GUIX_BITCOIN_BUILD_JOBS:?GUIX_BITCOIN_BUILD_JOBS is required}
host_true=${GUIX_BITCOIN_HOST_TRUE:?GUIX_BITCOIN_HOST_TRUE is required}
prewarm_url=${GUIX_BITCOIN_PREWARM_URL:?GUIX_BITCOIN_PREWARM_URL is required}
prewarm_jobs=16
native_systems=${GUIX_BITCOIN_NATIVE_SYSTEMS:?GUIX_BITCOIN_NATIVE_SYSTEMS is required}
target_hosts=${GUIX_BITCOIN_TARGET_HOSTS:?GUIX_BITCOIN_TARGET_HOSTS is required}
time_machine_url=${GUIX_BITCOIN_TIMEMACHINE_URL:?GUIX_BITCOIN_TIMEMACHINE_URL is required}
time_machine_commit=${GUIX_BITCOIN_TIMEMACHINE_COMMIT:?GUIX_BITCOIN_TIMEMACHINE_COMMIT is required}

mkdir -p "$jobs_dir/.tmp" "$jobs_dir/queued" "$jobs_dir/running" \
    "$jobs_dir/succeeded" "$jobs_dir/failed" "$profiles_root" \
    "$repositories_dir" "$worktrees_root"

exec 8>"$jobs_dir/worker.lock"
if ! flock -n 8; then
    echo "Another guix-bitcoin-worker is already running"
    exit 0
fi

with_git_lock() {
    flock 9
    "$@"
    local status=$?
    flock -u 9
    return "$status"
}

exec 9>"$git_lock"

recover_running_jobs() {
    shopt -s nullglob
    for job in "$jobs_dir/running"/*; do
        [[ -d $job ]] || continue
        mv -T --no-clobber -- "$job" "$jobs_dir/queued/$(basename "$job")"
    done
    shopt -u nullglob
}

time_machine() {
    guix time-machine \
        --url="$time_machine_url" \
        --commit="$time_machine_commit" \
        --cores="$build_jobs" \
        --keep-failed \
        --fallback \
        -- "$@"
}

manifest_wrapper() {
    local system=$1
    local source=$2
    local output=$3
    mkdir -p "$(dirname "$output")"
    cat > "$output" <<EOF
(use-modules (guix))

(parameterize
  ((%current-system "$system"))
  (primitive-load "$source"))
EOF
}

prewarm_store_path() {
    local path=$1
    case $path in
        *.drv)
            return 0
            ;;
    esac
    local hash=${path##*/}
    hash=${hash%%-*}
    until curl -fsS -o /dev/null "$prewarm_url/$hash.narinfo"; do
        sleep 10
    done
}

prewarm_store_paths() {
    local path
    local running=0
    while IFS= read -r path; do
        prewarm_store_path "$path" &
        running=$((running + 1))
        if ((running == prewarm_jobs)); then
            wait -n
            running=$((running - 1))
        fi
    done
    while ((running > 0)); do
        wait -n
        running=$((running - 1))
    done
}

root_derivations() {
    local root_dir=$1
    shift
    local derivation root
    local -A seen=()
    mkdir -p "$root_dir"
    for derivation in "$@"; do
        [[ $derivation == /gnu/store/*.drv && -e $derivation ]] || {
            echo "invalid derivation path: $derivation" >&2
            return 1
        }
        [[ ${seen[$derivation]+yes} ]] && continue
        seen[$derivation]=yes
        root=$root_dir/$(basename "$derivation")
        if [[ -L $root ]]; then
            [[ $(readlink -f "$root") == "$derivation" ]] || {
                echo "GC root points to the wrong derivation: $root" >&2
                return 1
            }
            continue
        fi
        [[ ! -e $root ]] || {
            echo "GC root is not a symlink: $root" >&2
            return 1
        }
        guix build --derivations --root="$root" "$derivation" >/dev/null
    done
}

derivation_outputs_are_rooted() {
    local root_base=$1
    shift
    local root output
    local missing=false
    local index=0
    local output_count=$#

    for output in "$@"; do
        if ((output_count == 1)); then
            root=$root_base
        else
            root=$root_base-$index
        fi

        if [[ -L $root ]]; then
            [[ $(readlink -f "$root") == "$output" ]] || {
                echo "GC root points to the wrong derivation output: $root" >&2
                return 2
            }
        elif [[ -e $root ]]; then
            echo "GC root is not a symlink: $root" >&2
            return 2
        else
            missing=true
        fi
        ((index += 1))
    done

    [[ $missing == false ]]
}

materialize_derivation_outputs() {
    local root_dir=$1
    shift
    local derivation root output outputs_output root_status
    local -A seen=()
    local -a outputs=()

    mkdir -p "$root_dir"
    for derivation in "$@"; do
        [[ $derivation == /gnu/store/*.drv && -e $derivation ]] || {
            echo "invalid derivation path: $derivation" >&2
            return 1
        }
        [[ ${seen[$derivation]+yes} ]] && continue
        seen[$derivation]=yes

        if ! outputs_output=$(guix build \
            --cores="$build_jobs" \
            --keep-failed \
            --fallback \
            "$derivation"); then
            return 1
        fi
        outputs=()
        while IFS= read -r output; do
            [[ -n $output ]] && outputs+=("$output")
        done <<< "$outputs_output"
        ((${#outputs[@]} > 0)) || {
            echo "derivation has no outputs: $derivation" >&2
            return 1
        }

        root=$root_dir/$(basename "${derivation%.drv}")
        root_status=0
        derivation_outputs_are_rooted "$root" "${outputs[@]}" || root_status=$?
        case $root_status in
            0) continue ;;
            1) ;;
            *) return 1 ;;
        esac
        guix build \
            --cores="$build_jobs" \
            --keep-failed \
            --fallback \
            --root="$root" \
            "$derivation" >/dev/null
    done
}

materialize_derivation_closure_outputs() {
    local root_dir=$1
    shift
    local derivation path derivations_output
    local -a derivations=()

    if ! derivations_output=$(
        for derivation in "$@"; do
            guix gc --requisites "$derivation"
        done | while IFS= read -r path; do
            [[ $path == /gnu/store/*.drv ]] && printf '%s\n' "$path"
        done | sort -u
    ); then
        return 1
    fi
    while IFS= read -r derivation; do
        [[ -n $derivation ]] && derivations+=("$derivation")
    done <<< "$derivations_output"
    ((${#derivations[@]} > 0)) || {
        echo "derivation closure has no derivations" >&2
        return 1
    }

    materialize_derivation_outputs "$root_dir" "${derivations[@]}"
}

check_manifest() {
    local system=$1
    local host=$2
    local manifest_file=$3
    until HOST="$host" time_machine weather \
        --system="$system" \
        --substitute-urls="$prewarm_url" \
        --manifest="$manifest_file" | grep -q '100.0% substitutes available'; do
        sleep 10
    done
}

read_source_descriptor() {
    local job=$1

    source_repository=$(read_descriptor_value "$job/source_repository" source_repository) || return 1
    source_commit=$(read_descriptor_value "$job/source_commit" source_commit) || return 1

    [[ $source_repository != -* && -n $source_repository ]] || {
        echo "invalid source repository" >&2
        return 1
    }
    [[ $source_commit =~ ^[0-9a-f]{40}$ ]] || {
        echo "invalid source commit: $source_commit" >&2
        return 1
    }
}

read_descriptor_value() {
    local path=$1
    local name=$2
    local -a lines=()

    [[ -f $path ]] || {
        echo "missing source descriptor file: $name" >&2
        return 1
    }
    mapfile -t lines < "$path"
    ((${#lines[@]} == 1)) || {
        echo "source descriptor must contain exactly one line: $name" >&2
        return 1
    }
    [[ ${lines[0]} != *$'\r'* ]] || {
        echo "source descriptor contains a carriage return: $name" >&2
        return 1
    }
    printf '%s\n' "${lines[0]}"
}

prepare_worktree() {
    local job_id=$1
    local commit=$2
    local worktree=$worktrees_root/$job_id
    local current=

    [[ -d $repo_dir ]] || {
        echo "missing Git repository object store: $repo_dir" >&2
        return 1
    }
    if [[ -e $worktree ]]; then
        current=$(git -C "$worktree" rev-parse --verify HEAD 2>/dev/null || true)
        [[ $current == "$commit" ]] || {
            echo "existing worktree is not at requested commit: $worktree" >&2
            return 1
        }
        printf '%s\n' "$worktree"
        return 0
    fi

    with_git_lock git --git-dir "$repo_dir" worktree add \
        --detach "$worktree" "refs/guix-jobs/$job_id" >/dev/null
    current=$(git -C "$worktree" rev-parse --verify HEAD)
    [[ $current == "$commit" ]] || {
        echo "created worktree at unexpected commit: $current" >&2
        return 1
    }
    printf '%s\n' "$worktree"
}

materialize_native_system() {
    local job_id=$1
    local job=$2
    local system=$3
    local manifests_dir=$4
    local manifest source wrapper profile
    local derivation_roots_dir derivation_outputs_dir derivation_root output_root
    local derivations_output
    local host name
    local -a manifests=()
    local -a hosts=()
    local -a derivations=()

    mapfile -t manifests < <(find "$manifests_dir" -mindepth 1 -maxdepth 1 \
        -type f -name 'manifest_*.scm' -print | sort)
    read -r -a hosts <<< "$target_hosts"
    (("${#manifests[@]}" > 0 && "${#hosts[@]}" > 0)) || {
        echo "native system branch has no manifests or target hosts: $system" >&2
        return 1
    }

    for host in "${hosts[@]}"; do
        for manifest in "${manifests[@]}"; do
            name=$(basename "$manifest")
            source=$manifest
            wrapper=$job/work/wrappers/$system/$name
            profile=$profiles_root/$system/$job_id/$host/${name%.scm}
            derivation_roots_dir=$profile.derivations
            derivation_outputs_dir=$profile.derivation-outputs
            mkdir -p "$(dirname "$profile")"
            manifest_wrapper "$system" "$source" "$wrapper"

            echo "Building $job_id: $name for $host on $system"
            if ! HOST="$host" time_machine shell \
                --system="$system" \
                --manifest="$wrapper" \
                --cores="$build_jobs" \
                --root="$profile" \
                -- "$host_true"; then
                return 1
            fi

            if ! derivations_output=$(HOST="$host" time_machine build \
                --system="$system" \
                --manifest="$wrapper" \
                --derivations); then
                return 1
            fi
            mapfile -t derivations <<< "$derivations_output"
            if ((${#derivations[@]} == 0)) \
                || ! root_derivations "$derivation_roots_dir" "${derivations[@]}" \
                || ! materialize_derivation_closure_outputs "$derivation_outputs_dir" "${derivations[@]}"; then
                return 1
            fi
        done
    done

    echo "Prewarming Guix substitute closures for $job_id on $system"
    for host in "${hosts[@]}"; do
        for manifest in "${manifests[@]}"; do
            name=$(basename "$manifest")
            profile=$profiles_root/$system/$job_id/$host/${name%.scm}
            guix gc --requisites "$(readlink -f "$profile")"
            derivation_roots_dir=$profile.derivations
            for derivation_root in "$derivation_roots_dir"/*.drv; do
                [[ -L $derivation_root ]] || continue
                guix gc --requisites "$(readlink -f "$derivation_root")"
            done
            derivation_outputs_dir=$profile.derivation-outputs
            for output_root in "$derivation_outputs_dir"/*; do
                [[ -L $output_root ]] || continue
                guix gc --requisites "$(readlink -f "$output_root")"
            done
        done
    done | sort -u | prewarm_store_paths

    for host in "${hosts[@]}"; do
        for manifest in "${manifests[@]}"; do
            name=$(basename "$manifest")
            check_manifest "$system" "$host" "$job/work/wrappers/$system/$name"
        done
    done
}

materialize_job() {
    local job_id=$1
    local job=$jobs_dir/running/$job_id
    local worktree
    local manifests_dir
    local system branch_index branch_status failed_status
    local -a manifests=()
    local -a systems=()
    local -a hosts=()
    local -a branch_pids=()
    local -a branch_systems=()
    local -A seen_systems=()

    [[ -f $job/source_repository && -f $job/source_commit ]] || {
        echo "invalid job structure: $job_id" >&2
        return 1
    }
    if find "$job" -type l -print -quit | grep -q .; then
        echo "job contains a symlink: $job_id" >&2
        return 1
    fi
    read_source_descriptor "$job"

    worktree=$(prepare_worktree "$job_id" "$source_commit")
    manifests_dir=$worktree/contrib/guix
    [[ -d $manifests_dir ]] || {
        echo "job source has no contrib/guix directory: $job_id" >&2
        return 1
    }
    mapfile -t manifests < <(find "$manifests_dir" -mindepth 1 -maxdepth 1 \
        -type f -name 'manifest_*.scm' -print | sort)
    (("${#manifests[@]}" > 0)) || {
        echo "job has no contrib/guix/manifest_*.scm files: $job_id" >&2
        return 1
    }
    read -r -a systems <<< "$native_systems"
    read -r -a hosts <<< "$target_hosts"
    (("${#systems[@]}" > 0 && "${#hosts[@]}" > 0)) || {
        echo "native system and target host lists must not be empty" >&2
        return 1
    }
    for system in "${systems[@]}"; do
        [[ -z ${seen_systems[$system]+x} ]] || {
            echo "duplicate native system: $system" >&2
            return 1
        }
        seen_systems[$system]=1
    done

    for system in "${systems[@]}"; do
        (
            set -e
            materialize_native_system "$job_id" "$job" "$system" "$manifests_dir"
        ) &
        branch_pids+=("$!")
        branch_systems+=("$system")
    done

    failed_status=0
    for branch_index in "${!branch_pids[@]}"; do
        if wait "${branch_pids[$branch_index]}"; then
            branch_status=0
        else
            branch_status=$?
        fi
        if ((branch_status == 0)); then
            echo "Native system ${branch_systems[$branch_index]} succeeded for $job_id"
        else
            echo "Native system ${branch_systems[$branch_index]} failed for $job_id with status $branch_status" >&2
            if ((failed_status == 0)); then
                failed_status=$branch_status
            fi
        fi
    done
    return "$failed_status"
}

recover_running_jobs

while :; do
    claimed=false
    shopt -s nullglob
    for queued in "$jobs_dir/queued"/*; do
        [[ -d $queued ]] || continue
        job_id=$(basename "$queued")
        if ! [[ $job_id =~ ^[0-9]{8}T[0-9]{6}Z-[0-9]+-[0-9]+$ ]]; then
            echo "Skipping unsafe queued job name: $job_id" >&2
            continue
        fi
        if ! mv -T --no-clobber -- "$queued" "$jobs_dir/running/$job_id" 2>/dev/null \
            || [[ -e $queued ]]; then
            continue
        fi
        claimed=true
        job=$jobs_dir/running/$job_id
        set +e
        (materialize_job "$job_id") 2>&1 | tee -a "$job/worker.log"
        status=${PIPESTATUS[0]}
        set -e
        if ((status == 0)); then
            mv -T --no-clobber -- "$job" "$jobs_dir/succeeded/$job_id"
            echo "Job $job_id succeeded"
        else
            mv -T --no-clobber -- "$job" "$jobs_dir/failed/$job_id"
            echo "Job $job_id failed" >&2
            exit "$status"
        fi
        break
    done
    shopt -u nullglob
    [[ $claimed == true ]] || break
done
