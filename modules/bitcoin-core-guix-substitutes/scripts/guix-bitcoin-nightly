#!/usr/bin/env bash

set -euo pipefail

repository=${GUIX_BITCOIN_REPOSITORY:?GUIX_BITCOIN_REPOSITORY is required}
branch=${GUIX_BITCOIN_BRANCH:-master}

if [[ -z $repository || $repository == -* || $repository == *$'\n'* || $repository == *$'\r'* ]]; then
    echo "repository must be a safe single-line string" >&2
    exit 2
fi
if ! git check-ref-format "refs/heads/$branch"; then
    echo "invalid branch name: $branch" >&2
    exit 2
fi

line=$(git ls-remote --heads "$repository" "$branch")
if [[ -z $line ]]; then
    echo "branch not found in repository: $branch" >&2
    exit 1
fi
commit=${line%%$'\t'*}
if [[ ! $commit =~ ^[0-9a-f]{40}$ ]]; then
    echo "repository returned an invalid commit for $branch: $commit" >&2
    exit 1
fi

guix-bitcoin-submit \
    --repository "$repository" \
    "$commit"
