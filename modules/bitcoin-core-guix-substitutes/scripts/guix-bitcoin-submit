#!/usr/bin/env bash

set -euo pipefail

data_dir=${GUIX_BITCOIN_DATA_DIR:?GUIX_BITCOIN_DATA_DIR is required}
default_repository=${GUIX_BITCOIN_REPOSITORY:?GUIX_BITCOIN_REPOSITORY is required}
jobs_dir=$data_dir/jobs
repositories_dir=$data_dir/repositories
repo_dir=$repositories_dir/bitcoin.git
git_lock=$repositories_dir/git.lock

if [[ $(id -u) == 0 && -n ${GUIX_BITCOIN_BUILD_USER:-} ]]; then
    exec runuser -u "$GUIX_BITCOIN_BUILD_USER" --preserve-environment -- \
        bash "$0" "$@"
fi

repository=$default_repository
method=manual
commit=

usage() {
    echo "usage: guix-bitcoin-submit [--repository REPOSITORY] [--method manual|nightly] COMMIT" >&2
}

while (($#)); do
    case $1 in
        --repository)
            repository=${2:?--repository requires a value}
            shift 2
            ;;
        --method)
            method=${2:?--method requires a value}
            shift 2
            ;;
        --staged|--source-repository|--source-commit)
            usage
            exit 2
            ;;
        --*)
            usage
            exit 2
            ;;
        *)
            if [[ -n $commit ]]; then
                usage
                exit 2
            fi
            commit=$1
            shift
            ;;
    esac
done

if [[ -z $commit ]]; then
    usage
    exit 2
fi
if [[ $method != manual && $method != nightly ]]; then
    echo "method must be manual or nightly" >&2
    exit 2
fi
if [[ ! $commit =~ ^[0-9a-f]{40}$ ]]; then
    echo "commit must be a lowercase full 40-character SHA-1" >&2
    exit 2
fi
if [[ -z $repository || $repository == -* || $repository == *$'\n'* || $repository == *$'\r'* ]]; then
    echo "repository must be a non-empty, safe single-line string" >&2
    exit 2
fi

mkdir -p "$jobs_dir/.tmp" "$jobs_dir/queued" "$jobs_dir/running" \
    "$jobs_dir/succeeded" "$jobs_dir/failed" "$repositories_dir"
umask 027

repo_id=$(printf '%s' "$repository" | sha256sum | cut -d ' ' -f1)
repo_ref_prefix=refs/guix/repositories/$repo_id

exec 9>"$git_lock"
flock 9

if [[ ! -d $repo_dir ]]; then
    git init --bare "$repo_dir" >/dev/null
fi

git --git-dir "$repo_dir" fetch --prune --no-tags "$repository" \
    "+refs/heads/*:$repo_ref_prefix/heads/*" \
    "+refs/tags/*:$repo_ref_prefix/tags/*"

object_type=$(git --git-dir "$repo_dir" cat-file -t "$commit" 2>/dev/null || true)
if [[ $object_type != commit ]]; then
    echo "object is not a commit in fetched repository: $commit" >&2
    exit 1
fi
if ! git --git-dir "$repo_dir" for-each-ref \
    --contains="$commit" \
    --format='%(refname)' \
    "$repo_ref_prefix/heads" "$repo_ref_prefix/tags" | grep -q .; then
    echo "commit is not reachable from fetched repository refs: $commit" >&2
    exit 1
fi

while :; do
    job_id="$(date -u +%Y%m%dT%H%M%SZ)-$$-$RANDOM"
    if [[ ! -e $jobs_dir/queued/$job_id && ! -e $jobs_dir/running/$job_id \
        && ! -e $jobs_dir/succeeded/$job_id && ! -e $jobs_dir/failed/$job_id ]]; then
        break
    fi
done

tmp_dir=$(mktemp -d "$jobs_dir/.tmp/job.XXXXXX")
cleanup() {
    if [[ -e $tmp_dir ]]; then
        rm -rf -- "$tmp_dir"
        git --git-dir "$repo_dir" update-ref -d "refs/guix-jobs/$job_id" >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT

git --git-dir "$repo_dir" update-ref "refs/guix-jobs/$job_id" "$commit"
timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
{
    printf 'schema_version=2\n'
    printf 'job_id=%s\n' "$job_id"
    printf 'submitted_at=%s\n' "$timestamp"
    printf 'method=%s\n' "$method"
    printf 'source_repository=%s\n' "$repository"
    printf 'source_commit=%s\n' "$commit"
} > "$tmp_dir/metadata"
mv -T --no-clobber -- "$tmp_dir" "$jobs_dir/queued/$job_id"
if [[ -e $tmp_dir ]]; then
    echo "job destination already exists: $job_id" >&2
    exit 1
fi
trap - EXIT
echo "$job_id"
